# Canvathèque : copiez ce fichier en .env et adaptez les valeurs.
# Les variables sont validées au démarrage (lib/env.ts) : une valeur manquante arrête le serveur.

# --- Application ---
APP_URL=http://localhost:3000
LOG_LEVEL=info
# Secret de session (32 caractères minimum) : openssl rand -base64 32
AUTH_SECRET=change-me-change-me-change-me-change-me

# --- PostgreSQL ---
POSTGRES_USER=canvatheque
POSTGRES_PASSWORD=canvatheque
POSTGRES_DB=canvatheque
# Utilisée par les outils lancés sur l'hôte (prisma, seed, next dev hors conteneur).
# Dans Docker Compose, DATABASE_URL et S3_ENDPOINT sont recalculées pour le réseau interne.
DATABASE_URL=postgresql://canvatheque:canvatheque@localhost:5432/canvatheque

# --- Stockage objet (MinIO, compatible S3) ---
S3_ENDPOINT=http://localhost:9000
# URL vue par le navigateur (aperçus, URL présignées). Production : https://s3.votre-domaine (voir docker/Caddyfile.example)
S3_PUBLIC_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=canvatheque
S3_SECRET_KEY=canvatheque-secret
S3_BUCKET_MODELS=models
S3_BUCKET_PREVIEWS=previews

# --- E-mail (Mailpit en développement) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Canvathèque <no-reply@canvatheque.local>"

# --- Administration ---
ADMIN_EMAIL=admin@canvatheque.local
# Optionnel (développement) : sinon un lien de définition du mot de passe est émis au démarrage
ADMIN_PASSWORD=
# Mot de passe des membres de démonstration créés par le seed (vide = aléatoire, affiché)
SEED_MEMBER_PASSWORD=

# --- Limites ---
MAX_FILE_SIZE_MB=20
MAX_MODELS_PER_USER=200
SIGNED_URL_TTL_SECONDS=300
RATE_LIMIT_LOGIN_PER_15MIN=10
RATE_LIMIT_SIGNUP_PER_HOUR=5
RATE_LIMIT_RESET_PER_HOUR=3
RATE_LIMIT_UPLOAD_PER_HOUR=20
RATE_LIMIT_DOWNLOAD_PER_HOUR=60
RATE_LIMIT_COMMENT_PER_HOUR=30
RATE_LIMIT_REPORT_PER_DAY=10

# --- Mentions légales (pages /legal ; vide = « à compléter » affiché) ---
# Éditeur du site (nom ou raison sociale) et adresse postale
LEGAL_PUBLISHER=
LEGAL_ADDRESS=
# Hébergeur (nom, adresse)
LEGAL_HOST=
# Adresse de contact (questions, exercice des droits RGPD)
CONTACT_EMAIL=

# --- Miniature des projets CanvasWorkspace (ADR-013) ---
# Clé AES-256 (64 caractères hexadécimaux) et IV (32) de déchiffrement des .cwprj, pour en
# extraire l'aperçu à l'envoi. Vides = fonction désactivée (le membre fournit une image).
# Plusieurs paires possibles, séparées par des virgules. Activation : décision de l'éditeur
# du site ; ne jamais committer ces valeurs.
CWPRJ_KEY=
CWPRJ_IV=

# --- Observabilité ---
# Jeton Bearer de /api/metrics (vide = point d'accès désactivé)
METRICS_TOKEN=
# Vide = Sentry désactivé
SENTRY_DSN=

# --- SonarQube (profil « quality ») ---
# Vide : mot de passe admin généré et conservé dans .sonar/admin-password
SONAR_ADMIN_PASSWORD=
SONAR_TOKEN=
